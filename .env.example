# Токен от @BotFather
BOT_TOKEN=123456:AAE...

# Максимальный размер файла, который бот отправит в Telegram (МБ).
# Для обычного Bot API — 50. Если поднимете локальный Bot API server — можно до 2000.
MAX_UPLOAD_MB=49

# Сколько загрузок выполняется одновременно
MAX_CONCURRENT_DOWNLOADS=2

# Антиспам: минимальный интервал между запросами одного пользователя (сек)
USER_COOLDOWN_SEC=5
# Максимум задач в очереди на одного пользователя
MAX_USER_QUEUE=2

# Универсальный режим: принимать ссылки с любых сайтов, которые умеет yt-dlp.
# 0 = только известные площадки из KNOWN_PLATFORMS
UNIVERSAL_MODE=1

# Добровольные донаты через Telegram Stars
DONATE_ENABLED=1
# Показывать ненавязчивую плашку о поддержке после каждой N-й загрузки (0 = никогда)
DONATE_EVERY=10

# Файл базы (счётчик загрузок и журнал донатов)
DB_PATH=/data/vdlbot.sqlite3

# Куда складывать временные файлы
DOWNLOAD_DIR=/tmp/vdlbot

# Файл cookies в формате Netscape (нужен для приватных/возрастных видео, часто для Instagram).
# Оставьте пустым, если не используете.
COOKIES_FILE=

# Прокси для yt-dlp, если с сервера нет прямого доступа к площадке.
# Поддерживается http/https/socks5, можно с логином:
#   PROXY=socks5://user:pass@127.0.0.1:1080
#   PROXY=http://10.0.0.5:3128
PROXY=

# Ходить только по IPv4 (помогает, если у сервера кривой IPv6). 1 = включить
FORCE_IPV4=

# Белый список пользователей через запятую (Telegram user id). Пусто = бот открыт для всех.
ALLOWED_USERS=

# Необязательно: адрес локального Bot API server, напр. http://telegram-bot-api:8081
LOCAL_BOT_API=
